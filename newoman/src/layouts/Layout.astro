---
import Navbar from '@components/structure/Navbar.astro';
import Footer from '@components/structure/Footer.astro';
import Global from '@components/Global.astro';

const { title, description } = Astro.props,
  siteName = 'Newoman';

const pageTitle = title && title !== '404' ? `${title} | ${siteName}` : siteName;
---

<html lang="es">
  <head>
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <Global description={description} />
  </head>
  <body>
    <header>
      <Navbar />
    </header>
    <main>
      <slot />
    </main>
    <Footer />
    <script type="module" src="/src/scripts/script.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
